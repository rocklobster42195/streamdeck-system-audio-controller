{
    "name": "sac",
    "private": true,
    "description": "SA-C — System Audio Controller for Elgato Stream Deck (monorepo)",
    "license": "MIT",
    "author": "Boris Kemper",
    "type": "module",
    "workspaces": [
        "plugin"
    ],
    "scripts": {
        "build": "npm run build -w sac-plugin",
        "watch": "npm run watch -w sac-plugin",
        "test": "vitest run",
        "lint": "eslint plugin/src",
        "icons": "node tools/generate-icons.mjs",
        "check": "npm run build && npm test && npm run lint && npm run validate -w sac-plugin",
        "sim:output": "node tools/sd-sim/output.mjs sim-out",
        "sim:apps": "node tools/sd-sim/apps.mjs sim-out",
        "sim:duck": "node tools/sd-sim/duck.mjs sim-out",
        "sim:players": "node tools/sd-sim/players.mjs",
        "sim:call": "node tools/sd-sim/call.mjs",
        "sim:app-output": "node tools/sd-sim/app-output.mjs sim-out"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "~24.3.0",
        "eslint": "^10.6.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.10",
        "ws": "^8.21.3"
    }
}
